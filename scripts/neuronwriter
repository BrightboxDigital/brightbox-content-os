#!/usr/bin/env bash
# Wrapper: runs neuronwriter.py inside the repo venv.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$DIR/../.venv/bin/python3"
if [ ! -x "$VENV" ]; then
  echo "venv missing. Create it with:" >&2
  echo "  python3 -m venv '$DIR/../.venv'" >&2
  exit 1
fi
exec "$VENV" "$DIR/neuronwriter.py" "$@"
